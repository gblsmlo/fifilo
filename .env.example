NODE_ENV=development
API_PORT=3001
POSTGRES_DB=fifilo
POSTGRES_USER=fifilo
POSTGRES_PASSWORD=fifilo
POSTGRES_APP_USER=fifilo_app
POSTGRES_APP_PASSWORD=fifilo_app
DATABASE_URL=postgresql://fifilo_app:fifilo_app@localhost:5432/fifilo
DATABASE_MIGRATION_URL=postgresql://fifilo:fifilo@localhost:5432/fifilo
COMPOSE_DATABASE_URL=postgresql://fifilo_app:fifilo_app@postgres:5432/fifilo
COMPOSE_DATABASE_MIGRATION_URL=postgresql://fifilo:fifilo@postgres:5432/fifilo
DATABASE_POOL_MAX=5
BETTER_AUTH_SECRET=local-development-secret-change-me-123456
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
APP_NAME=Fifilo
APP_URL=http://localhost:3000
VITE_APP_ENV=development
VITE_APP_NAME=Fifilo
# Optional individually (Fase 07): the AI layer degrades to "provider
# unconfigured" for whichever of these is absent, rather than failing to boot.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
